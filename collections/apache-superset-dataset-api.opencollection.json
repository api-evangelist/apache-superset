                "type": "path"
              }
            ]
          },
          "docs": "Update dataset"
        },
        {
          "info": {
            "name": "Delete dataset",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://localhost:8088/api/v1/dataset/:pk",
            "params": [
              {
                "name": "pk",
                "value": "",
                "type": "path"
              }
