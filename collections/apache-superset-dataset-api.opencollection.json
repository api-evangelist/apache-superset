{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache Superset REST Annotation Layer Dataset API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Dataset",
        "type": "folder"
      },
